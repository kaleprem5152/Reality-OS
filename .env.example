# ==============================================================================
# RealityOS Environment Configuration
# All credentials are safe placeholders. RealityOS operates gracefully in
# deterministic demo mode if these values are not provided.
# ==============================================================================

# PostgreSQL / Supabase Database Connection String (Server-side)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"

# Supabase Auth & Storage (Client-side & Server-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Google Gemini API Key (Server-side ONLY — Never exposed to browser clients)
# Used by AI Planning Studio to execute live LLM syntheses.
# If omitted, RealityOS runs structured deterministic infrastructure analyses.
GEMINI_API_KEY=""
